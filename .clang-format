#
# Formatting for the kernel, the C library, and the test programs.
# The style follows the existing code: 4-space indent, attached braces,
# 80 columns (matching .editorconfig), includes in their written order.
---
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 80
AllowShortFunctionsOnASingleLine: None
SortIncludes: false
